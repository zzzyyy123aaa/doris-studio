# Doris FE 的 MySQL 协议连接参数
DORIS_HOST=fe.example.internal
DORIS_PORT=9030
DORIS_USER=doris_studio_reader
DORIS_PASSWORD=

# 新集群可留空。设置后作为 SQL 工作台的默认库。
DORIS_DATABASE=

# FE 已配置 MySQL TLS 时启用。使用私有 CA 时填写证书路径。
# DORIS_TLS=true
# DORIS_TLS_CA_FILE=/etc/doris-studio/fe-ca.pem

# 服务监听 127.0.0.1。仓库内的网关和升级脚本使用 4173。
STUDIO_PORT=4173

# 直接用 Node 部署时指定可写目录以持久保存监控历史。
# 未设置时，新增数据源和告警配置默认保存在当前工作目录下的 studio-data。
# 按 README 部署容器时使用 /app/monitoring-data 及对应数据卷。
# STUDIO_MONITORING_DIR=/var/lib/doris-studio/monitoring
